# LLM provider selection. "none" = tools-only (HTNToolsOnly / L0), no network, no key needed.
LLM_PROVIDER=openrouter          # openrouter | openai | anthropic | none
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Per-leaf model override; falls back to LLM_MODEL if unset.
LLM_MODEL=anthropic/claude-sonnet-5
LLM_MODEL_L1=
LLM_MODEL_L2=
LLM_MODEL_L3=
LLM_MODEL_L4=
LLM_MODEL_L5=
LLM_MODEL_L6=

# off (no calls, defaults only) | record (call + cache) | replay (cache only, error on miss) | live (always call)
LLM_MODE=off
LLM_MAX_USD_PER_RUN=2.00

# Where replay/record caches live, and where run traces are written. Both default to off/unset.
LLM_CACHE_DIR=llm_cache
TRACE_DIR=

# Params file override (defaults to harness/params/default.json).
PARAMS_PATH=

# Inject a deterministic failure into the LLM layer for fail-soft tests: timeout | malformed |
# out_of_range | budget | exception
FAULT_INJECT=
